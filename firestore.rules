rules_version = '2';

// ════════════════════════════════════════════════════════════════
// Lobo24 — Firestore Security Rules
//
// Reemplaza la regla actual ("allow read, write: if true"), que deja
// toda la base de datos abierta a cualquier persona en internet.
//
// ⚠️ IMPORTANTE ANTES DE DESPLEGAR ESTO:
//   admin.html SÍ inicia sesión real con Firebase Auth (getAuth +
//   onAuthStateChanged, líneas ~130-292), así que sus lecturas y
//   escrituras van a seguir funcionando.
//
//   pedidos-live.js, en cambio, NO inicia sesión: solo abre Firestore
//   y escucha "pedidos" sin autenticarse. Con estas reglas activas,
//   esa pantalla va a dejar de ver pedidos y de poder cambiar su
//   estado ("En preparación" / "Entregado") hasta que se le agregue
//   un login real (mismo patrón que admin-login.js). Avisame cuando
//   quieras que lo resolvamos.
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Lista blanca de administradores (mismo criterio que admin-login.js).
    // El email viene del token de Firebase Auth, firmado por Google:
    // el cliente no puede falsificarlo.
    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email in ['rodrigoatatat@gmail.com'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Permite que un usuario NO autenticado descuente stock al comprar
    // (transferencia/efectivo), pero solo eso: no puede tocar precio,
    // nombre, ni subir el stock. Es un parche temporal — lo ideal es
    // que este descuento lo haga el backend con la Admin SDK.
    function isValidStockDecrement() {
      let before = resource.data;
      let after  = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['stock']) &&
             after.stock is number && before.stock is number &&
             after.stock >= 0 &&
             after.stock <= before.stock;
    }

    // ─── Catálogo de productos por categoría ──────────────────
    // bebidas, snacks, almacen, higiene, limpieza, congelados,
    // lacteos, panaderia, mascotas. "ofertas" ya no es una colección
    // real — la página de ofertas se arma en vivo con los productos que
    // tengan badge "offer" en su categoría real (ver ofertas.html).
    match /{coleccion}/{docId} {
      allow read: if coleccion in [
        'bebidas', 'snacks', 'almacen', 'higiene', 'limpieza',
        'congelados', 'lacteos', 'panaderia', 'mascotas'
      ];
      allow create, delete: if coleccion in [
        'bebidas', 'snacks', 'almacen', 'higiene', 'limpieza',
        'congelados', 'lacteos', 'panaderia', 'mascotas'
      ] && isAdmin();
      allow update: if coleccion in [
        'bebidas', 'snacks', 'almacen', 'higiene', 'limpieza',
        'congelados', 'lacteos', 'panaderia', 'mascotas'
      ] && (isAdmin() || isValidStockDecrement());
    }

    // ─── Contenido de la home / admin (nombres reales de colección,
    // confirmados en index.html y admin.html — OJO que no coinciden
    // con los nombres de variables JS: bestSellers ≠ "best", etc.) ──
    // carousel, promos, categories, bestSellers, newProducts,
    // offersStrip, ofertasIndex
    match /{coleccion}/{docId} {
      allow read: if coleccion in [
        'carousel', 'promos', 'categories', 'bestSellers',
        'newProducts', 'offersStrip', 'ofertasIndex'
      ];
      allow write: if coleccion in [
        'carousel', 'promos', 'categories', 'bestSellers',
        'newProducts', 'offersStrip', 'ofertasIndex'
      ] && isAdmin();
    }

    // ─── Configuración del sitio ───────────────────────────────
    // config/general, config/sections — leídos sin login en todas
    // las páginas públicas (topbar, banner, secciones visibles, etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Usuarios ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Alta al registrarse (handleRegister en app-global.js)
      allow create: if isOwner(userId) &&
                     request.resource.data.points == 0;

      // El dueño puede editar su propio perfil y sus puntos.
      // TODO: mover el cálculo de puntos ganados/usados al backend
      // para que el cliente no pueda escribir cualquier valor.
      allow update: if isAdmin() ||
                     (isOwner(userId) &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['name', 'phone', 'email', 'points']));

      allow delete: if isAdmin();
    }

    // ─── Pedidos ───────────────────────────────────────────────
    match /pedidos/{pedidoId} {
      // Se permite crear sin login (compra como invitado), pero con
      // una validación mínima de forma. La verdad de precios/total
      // debería validarse en el backend antes de cobrar (ver
      // webVentas-backend/server.js: /crear-preferencia confía en
      // el total que manda el cliente).
      allow create: if request.resource.data.keys().hasAll(
                      ['orderId', 'contact', 'items', 'total', 'payment', 'status', 'createdAt']
                    ) &&
                    request.resource.data.total is number &&
                    request.resource.data.total > 0;

      // Un cliente logueado puede ver SU historial de compras
      // (usuario.js filtra por where userId == auth.uid); el admin
      // puede ver y gestionar todos los pedidos. El resto de los
      // datos del cliente (nombre, email, teléfono, dirección)
      // queda protegido.
      allow read: if isAdmin() ||
                   (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Cualquier otra colección no listada arriba queda denegada
    // por defecto (Firestore deniega si ninguna regla permite).
  }
}
